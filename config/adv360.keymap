#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/stp.h>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
      #include "macros.dtsi"
      #include "version.dtsi"

      // --- Mirrored Programmer's Dvorak Mod-Morphs ---
      // Tap = Symbol, Shift + Tap = Number (1-0 in order)

      // Left Hand (Numbers 1-5)
      cd_sym_1: cd_sym_1 { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>; bindings = <&kp DLLR>, <&kp N1>; mods = <(MOD_LSFT|MOD_RSFT)>; };
      cd_sym_2: cd_sym_2 { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>; bindings = <&kp PLUS>, <&kp N2>; mods = <(MOD_LSFT|MOD_RSFT)>; };
      cd_sym_3: cd_sym_3 { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>; bindings = <&kp LBKT>, <&kp N3>; mods = <(MOD_LSFT|MOD_RSFT)>; };
      cd_sym_4: cd_sym_4 { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>; bindings = <&kp LBRC>, <&kp N4>; mods = <(MOD_LSFT|MOD_RSFT)>; };
      cd_sym_5: cd_sym_5 { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>; bindings = <&kp LPAR>, <&kp N5>; mods = <(MOD_LSFT|MOD_RSFT)>; };

      // Right Hand (Numbers 6-0)
      cd_sym_6: cd_sym_6 { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>; bindings = <&kp RPAR>, <&kp N6>; mods = <(MOD_LSFT|MOD_RSFT)>; };
      cd_sym_7: cd_sym_7 { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>; bindings = <&kp RBRC>, <&kp N7>; mods = <(MOD_LSFT|MOD_RSFT)>; };
      cd_sym_8: cd_sym_8 { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>; bindings = <&kp RBKT>, <&kp N8>; mods = <(MOD_LSFT|MOD_RSFT)>; };
      cd_sym_9: cd_sym_9 { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>; bindings = <&kp STAR>, <&kp N9>; mods = <(MOD_LSFT|MOD_RSFT)>; };
      cd_sym_0: cd_sym_0 { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>; bindings = <&kp EXCL>, <&kp N0>; mods = <(MOD_LSFT|MOD_RSFT)>; };

      // Edge Cases for Ops/Terminal efficiency
      cd_extra_L: cd_extra_L { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>; bindings = <&kp AMPS>,  <&kp TILDE>; mods = <(MOD_LSFT|MOD_RSFT)>; };
      cd_extra_R: cd_extra_R { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>; bindings = <&kp MINUS>, <&kp UNDER>; mods = <(MOD_LSFT|MOD_RSFT)>; };
      cd_mid_R: cd_mid_R { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>; bindings = <&kp PIPE>,  <&kp GRAVE>;  mods = <(MOD_LSFT|MOD_RSFT)>; };

      hm: homerow_mods {
          compatible = "zmk,behavior-hold-tap";
          label = "HOMEROW_MODS";
          #binding-cells = <2>;
          tapping-term-ms = <200>;
          quick_tap_ms = <175>;
          flavor = "tap-preferred";
          bindings = <&kp>, <&kp>;
      };
    };

  keymap {
    compatible = "zmk,keymap";

    default_layer {
      display-name = "Base";
      bindings = <
        // Top Row Optimized for Programmer's Dvorak
        &cd_extra_L &cd_sym_1 &cd_sym_2 &cd_sym_3 &cd_sym_4 &cd_sym_5 &tog 1                                                           &mo 3 &cd_sym_6 &cd_sym_7 &cd_sym_8 &cd_sym_9 &cd_sym_0 &cd_extra_R
        &kp TAB     &kp SEMI   &kp COMMA &kp DOT   &kp P     &kp Y     &none                                                            &none &kp F     &kp G     &kp C     &kp R     &kp L     &cd_mid_R
        &kp ESC     &kp A      &kp O     &kp E     &kp U     &kp I     &none           &kp LCTRL &kp LALT &kp LGUI  &kp RCTRL           &none &kp D     &kp H     &kp T     &kp N     &kp S     &kp BSLH
        &kp LSHFT   &kp SQT    &kp Q     &kp J     &kp K     &kp X                            &kp HOME &kp PG_UP                           &kp B     &kp M     &kp W     &kp V     &kp Z     &kp RSHFT
        &mo 2       &kp AT  &kp CAPS  &kp LEFT  &kp RIGHT                &kp BSPC &kp DEL   &kp END  &kp PG_DN &kp ENTER &kp SPACE              &kp UP    &kp DOWN  &kp QMARK  &kp EQUAL    &mo 2
      >;
    };

    keypad {
      display-name = "Kp";
      bindings = <
        &kp EQUAL &kp N1    &kp N2   &kp N3   &kp N4     &kp N5 &trans                                                           &mo 3 &kp N6 &kp KP_NUM &kp KP_EQUAL &kp KP_DIVIDE &kp KP_MULTIPLY &kp MINUS
        &kp TAB   &kp Q     &kp W    &kp E    &kp R      &kp T  &none                                                            &none &kp Y  &kp KP_N7  &kp KP_N8    &kp KP_N9     &kp KP_MINUS    &kp BSLH
        &kp ESC   &kp A     &kp S    &kp D    &kp F      &kp G  &none           &kp LCTRL &kp LALT &kp LGUI  &kp RCTRL           &none &kp H  &kp KP_N4  &kp KP_N5    &kp KP_N6     &kp KP_PLUS     &kp SQT
        &kp LSHFT &kp Z     &kp X    &kp C    &kp V      &kp B                            &kp HOME &kp PG_UP                           &kp N  &kp KP_N1  &kp KP_N2    &kp KP_N3     &kp KP_ENTER    &kp RSHFT
        &mo 2     &kp GRAVE &kp CAPS &kp LEFT &kp RIGHT                &kp BSPC &kp DEL   &kp END  &kp PG_DN &kp ENTER &kp KP_N0              &kp UP     &kp DOWN     &kp KP_DOT    &kp RBKT        &mo 2
      >;
    };

    fn {
      display-name = "Fn";
      bindings = <
        &kp F1 &kp F2 &kp F3 &kp F4 &kp F5 &kp F6 &tog 1                                           &mo 3 &kp F7 &kp F8 &kp F9 &kp F10 &kp F11 &kp F12
        &trans &trans &trans &trans &trans &trans  &none                                           &none &trans &trans &trans &trans  &trans  &trans
        &trans &trans &kp C_PREV &kp C_PP &kp C_NEXT &trans  &none        &trans &trans &trans &trans        &none &trans &trans &trans &trans  &trans  &trans
        &trans &trans &kp C_VOL_DN &kp C_MUTE &kp C_VOL_UP &trans                      &trans &trans                     &trans &trans &trans &trans  &trans  &trans
        &trans &trans &trans &trans &trans               &trans &trans &trans &trans &trans &trans              &trans &trans &trans  &trans  &trans
      >;
    };

    mod {
      display-name = "Mod";
      bindings = <
        &none &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &none                                                                     &trans                 &none        &none        &none        &none &none &none
        &none &none        &none        &none        &none        &none        &bootloader                                                               &bootloader            &none        &none        &none        &none &none &none
        &studio_unlock &none        &none        &none        &none        &none        &none                   &none &none &bt BT_CLR &none                      &stp STP_BAT &none        &none        &none        &none &none &none
        &none &none        &none        &none        &macro_ver   &none                                      &none &none                                                        &none        &none        &none        &none &none &none
        &none &none        &none        &none        &none                                       &none &none &none &none      &bl BL_TOG &rgb_ug RGB_TOG                                     &bl BL_INC   &bl BL_DEC   &none &none &none
      >;
    };

    extra1 { 
      display-name = "Red";    
      status = "reserved";
    };

    extra2 { 
      display-name = "Purple";    
      status = "reserved";
    };

    extra3 { 
      display-name = "Cyan";    
      status = "reserved";
    };

    extra4 { 
      display-name = "Yellow";    
      status = "reserved";
    };
  };
};
